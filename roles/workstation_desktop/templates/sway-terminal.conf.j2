# {{ ansible_managed }}
# Use Alacritty for the terminal shortcut and terminal applications in Rofi.
set $term alacritty
unbindsym $mod+Return
bindsym $mod+Return exec $term

# Rebuild the launcher command after changing the terminal variable.
set $rofi_cmd rofi -terminal '$term'
set $menu $rofi_cmd -show combi -combi-modes drun#run -modes combi
unbindsym $mod+d
bindsym $mod+d exec $menu
