# Samba configuration - managed by Ansible, do not edit manually

[global]
    workgroup = {{ nas_smb_workgroup }}
    server string = {{ nas_smb_server_string }}
    security = user
    passdb backend = tdbsam
    min protocol = {{ nas_smb_min_protocol }}
    log file = /var/log/samba/log.%m
    max log size = 50
    load printers = no
    printing = bsd
    printcap name = /dev/null

{% for share in nas_shares %}
{% if share.samba.enabled | default(false) %}
[{{ share.name }}]
    comment = {{ share.comment | default(share.name) }}
    path = {{ share.path }}
    browseable = {{ 'yes' if share.samba.browseable | default(true) else 'no' }}
    read only = {{ 'yes' if share.samba.read_only | default(false) else 'no' }}
    guest ok = {{ 'yes' if share.samba.guest_ok | default(true) else 'no' }}
    create mask = {{ share.samba.create_mask | default('0664') }}
    directory mask = {{ share.samba.directory_mask | default('0775') }}
{% if share.samba.valid_users is defined and share.samba.valid_users %}
    valid users = {{ share.samba.valid_users }}
{% endif %}

{% endif %}
{% endfor %}
